# A2 — TURN relay credentials for the voice engine.
#
# Copy to `turn.env` and fill in. `turn.env` is gitignored: these are secrets.
#
# WHY THIS MATTERS: with no TURN server, two users on mobile data (carrier-grade
# NAT) have no direct network path to each other and the voice link never comes
# up. STUN alone only works when at least one side is reachable from outside.
# This is the root cause of the repeated "الصوت بيقطع / الصوت راح خالص" reports.
#
# Standing up coturn on the existing AWS box:
#   sudo apt install coturn
#   # /etc/turnserver.conf
#   listening-port=3478
#   tls-listening-port=5349
#   fingerprint
#   lt-cred-mech
#   user=samafox:CHANGE_ME
#   realm=samafox
#   # open UDP+TCP 3478, TCP 5349, and UDP 49152-65535 in the security group
#
# Comma-separated. Keep BOTH a UDP and a TCP entry: some mobile networks and
# most corporate wifi block UDP outright, and the TCP/TLS entry is what gets
# those users through.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=samafox
TURN_CREDENTIAL=CHANGE_ME

# Optional overrides; leave blank to use the values compiled into AppConfig.
API_BASE_URL=
SOCKET_URL=
