{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5959"
      ],
      "cwd": "backend/public",
      "port": 5959
    },
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5757"
      ],
      "port": 5757,
      "cwd": "app"
    },
    {
      "name": "crazy-wheel-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/crazy_wheel_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5758",
        "--dart-define=API_BASE_URL=http://localhost:3100/api/v1/",
        "--dart-define=SOCKET_URL=http://localhost:3100"
      ],
      "cwd": "app",
      "port": 5758
    },
    {
      "name": "aetherfall-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/aetherfall_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5759"
      ],
      "cwd": "app",
      "port": 5759
    },
    {
      "name": "yummy-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "--transpile-only", "-P", "tsconfig.json", "../tools/yummy-mock/server.ts"],
      "cwd": "backend",
      "port": 3100
    },
    {
      "name": "yummy-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/yummy_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5761",
        "--dart-define=API_BASE_URL=http://localhost:3100/api/v1/"
      ],
      "cwd": "app",
      "port": 5761
    },
    {
      "name": "yummy-web-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5762"],
      "cwd": "app/build/web-yummy",
      "port": 5762
    },
    {
      "name": "olympus-preview",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-t",
        "lib/dev/olympus_preview.dart",
        "-d",
        "web-server",
        "--web-port",
        "5760"
      ],
      "cwd": "app",
      "port": 5760
    }
  ]
}