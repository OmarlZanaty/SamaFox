import { Router } from 'express';
import {
  getRooms,
  getRoomById,
  createRoom,
  updateRoom,
  deleteRoom,
  joinRoom,
  leaveRoom
} from '../controllers/room.controller';
import { authMiddleware, optionalAuth } from '../middleware/auth.middleware';
import { PrismaClient } from '@prisma/client';

const router = Router();
const prisma = new PrismaClient();

router.get('/', optionalAuth, getRooms);
router.get('/:roomId', optionalAuth, getRoomById);
router.post('/', authMiddleware, createRoom);
router.patch('/:roomId', authMiddleware, updateRoom);
router.delete('/:roomId', authMiddleware, deleteRoom);
router.post('/:roomId/join', authMiddleware, joinRoom);
router.post('/:roomId/leave', authMiddleware, leaveRoom);

// Get room messages (message history)
router.get('/:roomId/messages', authMiddleware, async (req: any, res) => {
  try {
    const roomId = parseInt(req.params.roomId);
    const limit = parseInt(req.query.limit as string) || 50;
    const offset = parseInt(req.query.offset as string) || 0;
    
    console.log(`📜 Fetching messages for room ${roomId}, limit: ${limit}, offset: ${offset}`);
    
    const messages = await prisma.roomMessage.findMany({
      where: { roomId },
      orderBy: { timestamp: 'desc' },
      take: limit,
      skip: offset
    });
    
    // Return oldest first (reverse the array)
    const messagesOldestFirst = messages.reverse();
    
    console.log(`✅ Found ${messagesOldestFirst.length} messages for room ${roomId}`);
    
    res.json(messagesOldestFirst);
  } catch (error) {
    console.error('❌ Error fetching messages:', error);
    res.status(500).json({ error: 'Failed to fetch messages' });
  }
});

export default router;
