import { Request, Response, NextFunction } from 'express';
import { verifyAccessToken } from '../utils/jwt';

export type AuthedRequest = Request & {
  userId?: number;
  user?: { id: number };
};
function extractToken(req: Request): string | null {
  // ✅ DEBUG (safe inside function)
  // comment these out after you finish debugging
  // console.log("🍪 raw cookie header:", req.headers.cookie);
  // console.log("🍪 parsed cookies:", (req as any).cookies);

  // 1) Authorization header
  const h = req.headers.authorization;
  if (h && h.startsWith('Bearer ')) return h.slice('Bearer '.length).trim();

  // 2) query token (optional)
  const q = (req.query?.token as string | undefined);
  if (q && q.length > 10) return q;

  // ✅ 3) cookie token (NEW)
  const c = (req as any).cookies?.access_token as string | undefined;
  if (c && c.length > 10) return c;

  return null;
}

export function authMiddleware(req: AuthedRequest, res: Response, next: NextFunction) {
  // ✅ DEBUG (correct place)
  // comment these out after you finish debugging
  // console.log("🍪 raw cookie header:", req.headers.cookie);
  // console.log("🍪 parsed cookies:", (req as any).cookies);

    console.log("🍪 cookie header:", req.headers.cookie);
  console.log("🍪 cookies parsed:", (req as any).cookies);
  try {
    const token = extractToken(req);
        console.log("🔑 extracted token length =", token?.length || 0);

    if (!token) return res.status(401).json({ success: false, message: 'Missing token' });

const payload = verifyAccessToken(token);

// ✅ attach user in BOTH styles (some controllers use req.userId, others use req.user.id)
req.userId = payload.userId;
(req as any).user = { id: payload.userId };

return next();
  } catch {
    return res.status(401).json({ success: false, message: 'Invalid token' });
  }
}

export function optionalAuth(req: AuthedRequest, _res: Response, next: NextFunction) {
  try {
    const token = extractToken(req);
    if (!token) return next();

    const payload = verifyAccessToken(token);
    req.userId = payload.userId;

    return next();
  } catch {
    return next();
  }
}

export const authenticate = authMiddleware;
