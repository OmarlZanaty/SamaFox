model ChargingAgency {
  id             Int                  @id @default(autoincrement())
  userId         Int
  agencyName     String
  phoneNumber    String
  agencyImageUrl String
  idFrontUrl     String
  idBackUrl      String
  status         String               @default("pending") // pending/approved/rejected
  type           String               @default("CHARGING")
  nameLocked     Boolean              @default(false) // when true, owner cannot rename the agency (dashboard-controlled)
  contactInfo    String?
  logoUrl        String?
  targetCoins    BigInt               @default(0)
  earnedCoins    BigInt               @default(0)
  topupRequests  AgencyTopupRequest[]
  members        AgencyMember[]
  invites        AgencyInvite[]

  // ✅ NEW: agency wallet
  balanceCoins Int @default(0)

  // Hosting-agency exit policy: when locked, a member must pay
  // exitPriceCoins (credited to the agency owner) to leave.
  exitLocked     Boolean @default(false)
  exitPriceCoins Int     @default(0)

  // optional stats
  totalSentCoins  Int @default(0)
  totalTopupCoins Int @default(0)

  // How many times this agency has charged ITSELF (an approved top-up request
  // or a direct admin top-up), and how much of the reward ladder it has
  // already been paid. The dashboard ranks agencies on `selfChargeCount` /
  // `totalTopupCoins` so the biggest charger can be rewarded
  // ("عاوز كل وكاله شحنت كام مره لنفسها ... هتاخد مكافأه").
  selfChargeCount   Int    @default(0)
  // Highest reward TIER (in coins charged) already granted, so a ladder never
  // pays the same rung twice.
  rewardedUpToCoins BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfers AgencyTransfer[]

  // #21/#23: set only when an admin/super-admin directly assigns this agency
  // to a user (bypassing the self-request+approval flow). Lets a super-admin
  // filter to "agencies I assigned" instead of seeing every agency.
  assignedByAdminId Int?
  assignedByAdmin   User? @relation("AgencyAssignedBy", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([assignedByAdminId])
  @@map("charging_agencies")
}

model AgencyTransfer {
  id        Int      @id @default(autoincrement())
  agencyId  Int
  toUserId  Int
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  agency ChargingAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  toUser User           @relation(fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([toUserId])
  @@map("agency_transfers")
}

model AgencyTopupRequest {
  id         Int       @id @default(autoincrement())
  agencyId   Int
  amount     Int
  receiptUrl String
  note       String?
  status     String    @default("pending") // pending/approved/rejected
  reviewedBy Int?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  agency ChargingAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  // ✅ reviewer relation must have a name + opposite name
  reviewer User? @relation("TopupReviewedBy", fields: [reviewedBy], references: [id])

  @@index([agencyId])
  @@index([status])
  @@map("agency_topup_requests")
}

// Target tiers: coins-earned threshold -> dollar payout. Admin-managed.
// Dollars for a given earned-coins amount are derived from these tiers
// (the ratio dollars/coins of the highest tier whose coins <= earned).
model TargetTier {
  id        Int      @id @default(autoincrement())
  coins     BigInt // coins threshold for this tier (e.g. 200000)
  dollars   Float // dollar value at this tier (e.g. 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("target_tiers")
}

// B11 — automatic reward for a charging agency that tops itself up past a
// threshold: "لو تخليني احدد من لوحة التحكم الوكاله لما تشحن عدد كوينزات معين
// احدد مكافأة تروح تلقائي". Each row is one rung of a ladder; every rung a
// top-up crosses pays out once (guarded by ChargingAgency.rewardedUpToCoins).
model AgencyChargeReward {
  id Int @id @default(autoincrement())

  // Cumulative coins the agency must have charged itself to earn this rung.
  thresholdCoins BigInt

  // What it pays. Either or both may be set.
  rewardCoins   Int      @default(0)
  rewardItemIds String[] @default([])

  // null = applies to every charging agency; set = this agency only.
  agencyId Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@map("agency_charge_rewards")
}

model AgencyRequest {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  type        String
  agencyName  String
  imageUrl    String?
  contactInfo String?
  status      String    @default("pending")
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model AgencyMember {
  id       Int            @id @default(autoincrement())
  agencyId Int
  agency   ChargingAgency @relation(fields: [agencyId], references: [id])
  userId   Int
  user     User           @relation(fields: [userId], references: [id])
  role     String         @default("MEMBER")
  joinedAt DateTime       @default(now())

  // Per-member TARGET GOAL set by the agency owner/admin. The member's *earned*
  // amount is derived from gifts received since joinedAt (excluding self-gifts);
  // remaining = targetGoalCoins - earned. 0 = no goal set. (#13, #24)
  targetGoalCoins BigInt @default(0)

  // Cumulative amount of *earned* target this member has already cashed out
  // via تبديل الكوينزات (target-swap, 50% conversion to coins). The target
  // total shown to the member is never reduced by a conversion — this field
  // exists purely to cap future conversions at (earned - convertedTargetCoins)
  // so the same earned coins can't be swapped for cash twice.
  convertedTargetCoins BigInt @default(0)

  // Agency-owner commission (#4) accumulated on this OWNER row. The client's
  // rule (2026-08): the وكيل's commission must NOT land in his wallet as extra
  // coins — it only raises HIS OWN TARGET, which he can then cash out through
  // the same تبديل/بيع 50% path as any other earned target. Always 0 for
  // non-owner rows. Counted into the owner's `earnedCoins` everywhere the
  // personal target is computed (never into the agency's production total,
  // which already contains the full gift the commission was cut from).
  commissionTargetCoins BigInt @default(0)

  // Commission this member GENERATED for their agency owner (#4) — the same
  // coins that landed in the owner's `commissionTargetCoins`, but attributed
  // to their source. Client rule (2026-08): commission is COUNTED on every
  // gift a member receives (self-gifts included), yet the owner may not cash
  // it out until that member completes their target. This column is what makes
  // the gate per-host; the owner's own row holds the commission cut from gifts
  // HE received, released by the agency target set on the dashboard.
  commissionGeneratedCoins BigInt @default(0)

  // Target moved by بيع التارجيت (2026-08). SIGNED: a sale subtracts from the
  // seller's row and adds the same amount to the buyer's, so a member's target
  // is (gifts received since joinedAt) + commission + this. Negative is normal
  // for someone who has sold. It is deliberately NOT a coin balance — the
  // dollar value follows from the resulting target through the TargetTier
  // table, which is why selling also moves the dollars.
  targetAdjustmentCoins BigInt @default(0)

  @@unique([agencyId, userId])
}

// One بيع التارجيت: the seller's target went down by `amountCoins` and the
// buyer's went up by the same. Kept for the dashboard and for complaint
// investigations — the AgencyMember rows only carry the running total.
model TargetSale {
  id             Int      @id @default(autoincrement())
  sellerId       Int
  buyerId        Int
  amountCoins    BigInt
  sellerAgencyId Int
  buyerAgencyId  Int
  // Dollar value of the sold amount at the tier rate in force at sale time,
  // so a later tier change doesn't rewrite history.
  dollarsValue   Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([sellerId])
  @@index([buyerId])
  @@map("target_sales")
}

model AgencyInvite {
  id        Int            @id @default(autoincrement())
  agencyId  Int
  agency    ChargingAgency @relation(fields: [agencyId], references: [id])
