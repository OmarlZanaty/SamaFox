  @@index([senderId])
}

// ============================================
// GIFT SYSTEM — production gift catalog
// PostgreSQL-only: uses Json columns and cuid string IDs.
// ============================================

enum GiftFormat {
  SVG_CSS
  VIDEO
}

enum GiftTier {
  SMALL
  MEDIUM
  LARGE
  LEGENDARY
}

enum GiftAuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  REORDER
}

model Gift {
  id               String     @id @default(cuid())
  name             String
  nameAr           String?
  iconUrl          String
  format           GiftFormat
  animationHtml    String?    @db.Text
  animationUrl     String?
  videoHasAlpha    Boolean    @default(false)
  fireworksEnabled Boolean    @default(false)
  fireworksColors  Json?
  coinCost         Int
  tier             GiftTier
  animationMs      Int        @default(3000)
  isComboEligible  Boolean    @default(true)
  broadcastGlobal  Boolean    @default(false)
  isActive         Boolean    @default(true)
  sortOrder        Int        @default(0)
  category         String?
  cpEligible       Boolean    @default(false) // counts toward account power (CP) when sent
  createdBy        Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  transactions GiftTransaction[]

  @@index([tier, isActive, sortOrder])
  @@index([category, isActive])
  @@map("gifts")
}

/// B4/B5/B6 — "أضف قائمة هدايا". Gift lists used to be a hard-coded dropdown in
/// the dashboard, so the app's gift-sheet tabs could never change without a
/// release. A list is now a row here: the dashboard creates one, a gift is
/// assigned to it on creation and can be moved between lists afterwards, and
/// the app builds its tabs from the list table instead of from a const map.
///
/// `key` is what lands in `Gift.category`, which keeps every existing gift
/// working: the seeded rows below reuse the keys the app already ships
/// ('love', 'luxury', …), so nothing is re-categorised by the migration.
model GiftCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  nameAr    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("gift_categories")
}

model GiftTransaction {
  id          String   @id @default(cuid())
  senderId    Int
  recipientId Int
  roomId      Int?
  giftId      String
  quantity    Int      @default(1)
  totalCoins  Int
  comboKey    String?
  comboCount  Int      @default(1)
  createdAt   DateTime @default(now())

  sender    User  @relation("GiftSender", fields: [senderId], references: [id])
  recipient User  @relation("GiftRecipient", fields: [recipientId], references: [id])
  gift      Gift  @relation(fields: [giftId], references: [id])
  room      Room? @relation("GiftRoom", fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("gift_transactions")
}

model GiftBroadcast {
  id            String   @id @default(cuid())
  transactionId String   @unique
  fromRoomId    Int?
  giftId        String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@map("gift_broadcasts")
}

model GiftAdminAudit {
  id        String          @id @default(cuid())
  adminId   Int
  giftId    String?
  action    GiftAuditAction
  diff      Json?
  createdAt DateTime        @default(now())

  @@index([giftId, createdAt])
  @@index([adminId, createdAt])
  @@map("gift_admin_audits")
}

// Personal blacklist (القائمة السوداء in app settings): plain scalar ids —
// no relation fields on User to keep the additive migration tiny.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("user_blocks")
}

// ============================================
// CLOSED-TESTING BETA ENROLMENT
// ============================================

// One visitor who asked for SamaFox from the Al Mobarmg store page.
//
// Play whitelists testers through an account-level **email list**, and an
// address on that list installs straight from the normal Play listing with no
// "become a tester" tap. There is no Google API for those lists, so the write
// is done by the operator's beta-sync daemon driving a logged-in Play Console:
// this table is the queue it reads (`playSynced = false`) and acks.
//
// `playError` doubles as a terminal marker — 'not_a_google_account' means Play
// refused the address and it must leave the queue instead of being retried
// forever (one such row used to block every signup behind it).
enum BetaTesterStatus {
  invited
  opted_in
  installed
  dropped
}

model BetaTester {
  id            String           @id @default(cuid())
  email         String           @unique
  googleSub     String?          @unique // Google "sub"; null for plain-email signups
  status        BetaTesterStatus @default(invited)
  source        String? // where the signup came from (e.g. "almobarmg-store")
  playSynced    Boolean          @default(false) // is the address on the Play list?
  playError     String? // last failure, or a terminal marker (see above)
  enrolledAt    DateTime         @default(now())
  lastCheckedAt DateTime?
  remindedAt    DateTime? // last nudge sent to a tester who never installed

  @@index([status])
  @@map("beta_testers")
}

// ============================================
// A15 — CP (نظام الـ CP): couple pairing by gift
// ============================================
//
// NOTE ON THE NAME: `User.cpPoints` and `Gift.cpEligible` are an unrelated,
// older "account power" counter. This section is the client's CP — a pairing
// between two people, created by sending a CP gift the other side accepts.
//
// Flow (client spec, 17/08 23:01):
//   A sends a CP gift to B  -> CpRequest(status = pending); nothing is charged
//   B accepts               -> the gift is sent for real (full price off A,
//                              value into B's target) and a CpPair is created
//   B rejects               -> no gift, but 30% of the price is still taken
//                              off A ("يتخصم منه 30% من قيمة الهدية")
//
// Charging on resolution rather than on send is what makes the 30%/100% split
// possible at all; the sender's balance is verified up front so a request can
// never be created that the sender could not afford.

model CpPair {
  id        Int      @id @default(autoincrement())
  // Stored with userAId < userBId so a pair exists at most once regardless of
  // who gifted whom, and the unique index below actually prevents duplicates.
  userAId   Int
  userBId   Int
  userA     User     @relation("CpPairUserA", fields: [userAId], references: [id])
  userB     User     @relation("CpPairUserB", fields: [userBId], references: [id])
  // The gift that created the pairing — shown on the profile CP card.
  giftId    String?
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("cp_pairs")
}

model CpRequest {
  id          Int       @id @default(autoincrement())
  senderId    Int
  recipientId Int
  sender      User      @relation("CpRequestSender", fields: [senderId], references: [id])
  recipient   User      @relation("CpRequestRecipient", fields: [recipientId], references: [id])
  giftId      String
  quantity    Int       @default(1)
  // Full price of the gift at request time. The 30% rejection fee and the
  // accepted charge are both derived from THIS, not from the live gift price,
  // so an admin editing the price mid-flight cannot change what was agreed.
  totalCoins  Int
  roomId      Int?
  status      String    @default("pending") // pending | accepted | rejected | cancelled | expired
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([recipientId, status])
  @@index([senderId, status])
  @@map("cp_requests")
}

/// Provably-fair seed state for بلينكو, نيون فورتشن and أثيرفول.
///
/// These used to live in a module-level Map per service, which meant every
/// deploy or restart silently reset the commitment: a player who had been given
/// a server-seed hash could no longer verify the spins made against it, and the
/// nonce restarted at zero. Persisting it makes the commitment mean what it
/// claims, and lets the games run on more than one process.
///
/// `serverSeed` is the secret half and must never leave the server except
/// through a deliberate rotation, which reveals the old seed and commits to a
/// new one.
model GameFairSeed {
  id             String   @id @default(cuid())
  userId         Int
  /// Which game the seed pair belongs to: plinko | neon_fortune | aetherfall.
  game           String
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  /// Spins drawn against this pair. Incremented atomically as each is reserved.
  nonce          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@map("game_fair_seeds")
}
