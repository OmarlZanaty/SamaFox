// This is your COMPLETE Prisma schema with ALL models + Phase 1 updates
// File: samafox-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL (UPDATED WITH PHASE 1)
// ============================================

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String?                   @unique
  phone                    String?                   @unique
  googleId                 String?                   @unique
  name                     String
  avatarUrl                String?
  countryCode              String? // NEW: ISO country code (e.g., "EG", "SA")
  gender                   String? // NEW: "male", "female", "other"
  bio                      String?
  coinsBalance             Int                       @default(0)
  level                    Int                       @default(1)
  xp                       Int                       @default(0)
  vipLevel                 Int                       @default(0)
  totalRecharge            Int                       @default(0) // cumulative coins ever charged (drives VIP level)
  vipExpiresAt             DateTime? // set when VIP was BOUGHT for a term; null = earned by recharge and permanent
  cpPoints                 Int                       @default(0) // account power (CP) accumulated from CP-eligible gifts sent
  age                      Int? // user-editable age (#3), shown on profile
  isAdmin                  Boolean                   @default(false)
  // Super-admin: elevated dashboard role that can appoint/revoke other admins
  // and super-admins (#23). A plain isAdmin can use the dashboard but cannot
  // manage the admin roster.
  isSuperAdmin             Boolean                   @default(false)
  isBanned                 Boolean                   @default(false)
  bannedAt                 DateTime?
  banReason                String?
  banExpiresAt             DateTime? // null = permanent when isBanned
  banSource                String? // 'dashboard' | 'admin' | 'system' — dashboard bans only liftable from dashboard
  nameLocked               Boolean                   @default(false) // when true, user cannot change their own name
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  passwordHash             String? // ✅ for email/password login
  isVerified               Boolean                   @default(false)
  lastLoginAt              DateTime?
  country                  String? // optional
  ownedRooms               Room[]                    @relation("RoomOwner")
  roomMemberships          RoomMember[]
  roomMessages             RoomMessage[]             @relation("RoomMessageSender")
  sentGifts                GiftTransaction[]         @relation("GiftSender")
  receivedGifts            GiftTransaction[]         @relation("GiftRecipient")
  sentMessages             Message[]                 @relation("MessageSender")
  receivedMessages         Message[]                 @relation("MessageReceiver")
  relationshipFollowers    Relationship[]            @relation("Following")
  relationshipFollowing    Relationship[]            @relation("Follower")
  followers                Follow[]                  @relation("UserFollowers")
  following                Follow[]                  @relation("UserFollowing")
  notifications            Notification[]            @relation("UserNotifications")
  actedNotifications       Notification[]            @relation("NotificationActor")
  relationsAsUser1         Relation[]                @relation("RelationUser1")
  relationsAsUser2         Relation[]                @relation("RelationUser2")
  transactions             Transaction[]
  reportsMade              Report[]                  @relation("Reporter")
  reportsReceived          Report[]                  @relation("Reported")
  achievements             UserAchievement[]
  quests                   UserQuest[]
  giftBattlesUser1         GiftBattle[]              @relation("GiftBattleUser1")
  giftBattlesUser2         GiftBattle[]              @relation("GiftBattleUser2")
  leaderboardEntries       LeaderboardEntry[]
  subscription             UserSubscription?
  items                    UserItem[]
  familyMembership         FamilyMember?
  ownedFamily              Family?                   @relation("FamilyOwner")
  roomVisits               RoomVisit[]
  bannedFromRooms          RoomBan[]                 @relation("BannedFromRoom")
  roomBans                 RoomBan[]                 @relation("RoomBanner")
  chargingAgencies         ChargingAgency[]
  agenciesAssignedByMe     ChargingAgency[]          @relation("AgencyAssignedBy")
  agencyRequests           AgencyRequest[]
  agencyMembers            AgencyMember[]
  reviewedTopups           AgencyTopupRequest[]      @relation("TopupReviewedBy")
  AgencyTransfer           AgencyTransfer[]
  conversationsA           Conversation[]            @relation("ConvUserA")
  conversationsB           Conversation[]            @relation("ConvUserB")
  conversationParticipants ConversationParticipant[]
  directMessagesSent       DirectMessage[]
  musicTracks              MusicTrack[]
  avatarFrameUrl           String?
  // Profile-page background chosen by the user: a still image, an animated GIF
  // or a video clip. `profileBgType` says which, so the page mounts a player
  // instead of an Image widget for a clip.
  profileBgUrl             String?
  profileBgType            String?                   @default("image") // image | video
  // إطار تزيين الصفحة الشخصية — a hollow decorated frame drawn ON the profile
  // page's border, image or video. Set from the store when the user equips a
  // PROFILE_DECOR item; null means the page has no decoration.
  profileDecorUrl          String?
  profileDecorType         String?                   @default("image") // image | video
  displayId                Int?                      @unique
  activeFrameId            String?
  activeFrame              Item?                     @relation("UserActiveFrame", fields: [activeFrameId], references: [id])
  relationId               Int?

  // B9 — "تصفير العداد" on أعلى المستويات. The owner tests by gifting heavily
  // and would otherwise sit at #1 forever. Setting this timestamp makes the
  // supporters board count only gifts sent AFTER it, so the account drops off
  // the board without losing a single coin of history — and climbs back at
  // whatever it genuinely earns from that moment on. Null = never reset.
  supportersResetAt DateTime?

  // A15 — CP (couple pairing). Both sides of a pair and the pending requests.
  cpPairsA           CpPair[]    @relation("CpPairUserA")
  cpPairsB           CpPair[]    @relation("CpPairUserB")
  cpRequestsSent     CpRequest[] @relation("CpRequestSender")
  cpRequestsReceived CpRequest[] @relation("CpRequestRecipient")

  gameFairSeeds GameFairSeed[]

  @@map("users")
}

model UserIdSequence {
  id     Int @id @default(1)
  nextId Int @default(10000)
}

// ============================================
// MUSIC TRACK MODEL
// ============================================

// A song the user uploaded from their phone. It is a PERSONAL library: the row
// (and the file) survive until the user deletes it themselves, so the same
// playlist is there the next time they open any room.
model MusicTrack {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  url       String
  filename  String
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("music_tracks")
}

// ============================================
// ROOM MODEL
// ============================================

model Room {
  id                  Int       @id @default(autoincrement())
  name                String
  description         String?
  coverImageUrl       String?
  backgroundImageUrl  String?
  // A background uploaded from the owner's device is paid for and rented, not
  // owned: this is when it reverts. null = the free/default background.
  backgroundExpiresAt DateTime?
  ownerId             Int
  type                String    @default("public")
  passwordHash        String?
  maxSeats            Int       @default(8)
  isActive            Boolean   @default(true)
  xp                  Int       @default(0)
  level               Int       @default(1)
  activeThemeId       String?
  isLocked            Boolean   @default(false)
  accessCode          String? // 5-digit PIN required to enter when isLocked (owner/admins bypass)
  nameLocked          Boolean   @default(false) // when true, owner cannot rename the room (dashboard-controlled)
  backgroundMusicUrl  String?
  muteGiftSounds      Boolean   @default(false)
  muteEntranceSounds  Boolean   @default(false)
  contributionResetAt DateTime? // #4: admin reset point for per-user room coin counters
  createdAt           DateTime  @default(now())

  owner           User              @relation("RoomOwner", fields: [ownerId], references: [id])
  members         RoomMember[]
  messages        RoomMessage[]
  gifts           GiftTransaction[] @relation("GiftRoom")
  reports         Report[]
  activeTheme     Item?             @relation(fields: [activeThemeId], references: [id])
  gameSessions    GameSession[]
  giftBattles     GiftBattle[]
  timedEvents     TimedEvent[]
  roomVisits      RoomVisit[]
  scheduledEvents ScheduledEvent[]
  pkBattlesRoom1  PkBattle[]        @relation("PkBattleRoom1")
  pkBattlesRoom2  PkBattle[]        @relation("PkBattleRoom2")
  bannedUsers     RoomBan[]

  @@map("rooms")
}

// ============================================
// ROOM MEMBER MODEL
// ============================================

model RoomMember {
  userId      Int
  roomId      Int
  role        String   @default("member")
  isMuted     Boolean  @default(false)
  forceMuted  Boolean  @default(false) // admin-muted; user cannot self-unmute
  seatBlocked Boolean  @default(false) // cannot take a seat until an admin clears it
  joinedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@id([userId, roomId])
  @@map("room_members")
}

// ============================================
// ROOM MESSAGE MODEL
// ============================================

model RoomMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  userId    Int
  username  String
  content   String
  timestamp DateTime @default(now())
  avatar    String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation("RoomMessageSender", fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@map("room_messages")
}

// ============================================
// ROOM BAN MODEL
// ============================================

model RoomBan {
  id        Int       @id @default(autoincrement())
  roomId    Int
  userId    Int
  bannedBy  Int
  reason    String?
  bannedAt  DateTime  @default(now())
  expiresAt DateTime?

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User @relation("BannedFromRoom", fields: [userId], references: [id], onDelete: Cascade)
  banner User @relation("RoomBanner", fields: [bannedBy], references: [id])

  @@unique([roomId, userId])
  @@map("room_bans")
}

// ============================================
// MESSAGE MODEL (PRIVATE MESSAGES)
// ============================================

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  type       String   @default("text")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@map("messages")
}

// ============================================
// RELATIONSHIP MODEL (FOLLOW/FOLLOWERS)
// ============================================

model Relationship {
  followerId  Int
  followingId Int
  type        String   @default("fan")
  status      String   @default("accepted")
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  @@id([followerId, followingId])
  @@map("relationships")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id])
  followingId Int
  following   User     @relation("UserFollowing", fields: [followingId], references: [id])
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   Int?
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String
  body      String
  isRead    Boolean   @default(false)
  data      Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Relation {
  id          Int       @id @default(autoincrement())
  user1Id     Int
  user1       User      @relation("RelationUser1", fields: [user1Id], references: [id])
  user2Id     Int
  user2       User      @relation("RelationUser2", fields: [user2Id], references: [id])
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([user1Id, user2Id])
}

// ============================================
// TRANSACTION MODEL
// ============================================

model Transaction {
  id            Int      @id @default(autoincrement())
  userId        Int
  type          String
  amountCoins   Int
  externalId    String?
  paymentMethod String?
  status        String   @default("pending")
  // AGENCY_TOPUP attribution: which agency charged the user and which member sent it (group 7)
  agencyId      Int?
  senderId      Int?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([agencyId])
  @@map("transactions")
}

// ============================================
// REPORT MODEL
// ============================================

model Report {
  id             Int      @id @default(autoincrement())
  reporterId     Int
  reportedUserId Int?
  roomId         Int?
  reason         String
  notes          String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User? @relation("Reported", fields: [reportedUserId], references: [id])
  room         Room? @relation(fields: [roomId], references: [id])

  @@map("reports")
}

// ============================================
// ACHIEVEMENT MODEL
// ============================================

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  iconUrl     String
  target      Int
  metric      String // e.g., "gifts_sent", "time_in_room"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@map("achievements")
}

// ============================================
// USER ACHIEVEMENT MODEL
// ============================================

model UserAchievement {
  id            String   @id @default(cuid())
  userId        Int
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ============================================
// DAILY QUEST MODEL
// ============================================

model DailyQuest {
  id          String   @id @default(cuid())
  name        String
  description String
  metric      String // e.g., "send_gift", "join_room"
  target      Int
  rewardCoins Int
  createdAt   DateTime @default(now())

  userQuests UserQuest[]

  @@map("daily_quests")
}

// ============================================
// USER QUEST MODEL
// ============================================

model UserQuest {
  id         String   @id @default(cuid())
  userId     Int
  questId    String
  progress   Int      @default(0)
  isComplete Boolean  @default(false)
  date       DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id])
  quest DailyQuest @relation(fields: [questId], references: [id])

  @@unique([userId, questId, date])
  @@map("user_quests")
}

// ============================================
// GAME MODEL
// ============================================

model Game {
  id          String   @id @default(cuid())
  name        String // e.g., "Truth or Dare", "Spin the Wheel"
  description String
  rules       String
  createdAt   DateTime @default(now())

  sessions GameSession[]

  @@map("games")
}

// ============================================
// GAME SESSION MODEL
// ============================================

model GameSession {
  id        String   @id @default(cuid())
  roomId    Int
  gameId    String
  isActive  Boolean  @default(true)
  xp        Int      @default(0)
  level     Int      @default(1)
  state     String // JSON stored as string for SQLite compatibility
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@map("game_sessions")
}

// ============================================
// GIFT BATTLE MODEL
// ============================================

model GiftBattle {
  id         String   @id @default(cuid())
  roomId     Int
  user1Id    Int
  user2Id    Int
  user1Score Int      @default(0)
  user2Score Int      @default(0)
  endsAt     DateTime
  isActive   Boolean  @default(true)
  xp         Int      @default(0)
  level      Int      @default(1)

  room  Room @relation(fields: [roomId], references: [id])
  user1 User @relation("GiftBattleUser1", fields: [user1Id], references: [id])
  user2 User @relation("GiftBattleUser2", fields: [user2Id], references: [id])

  @@map("gift_battles")
}

// ============================================
// TIMED EVENT MODEL
// ============================================

model TimedEvent {
  id          String   @id @default(cuid())
  roomId      Int?
  name        String
  description String
  multiplier  Float    @default(1.0)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(false)
  xp          Int      @default(0)
  level       Int      @default(1)

  room Room? @relation(fields: [roomId], references: [id])

  @@map("timed_events")
}

// ============================================
// LEADERBOARD MODEL
// ============================================

model Leaderboard {
  id        String   @id @default(cuid())
  name      String
  metric    String
  timeframe String // e.g., "daily", "weekly", "monthly"
  createdAt DateTime @default(now())

  entries LeaderboardEntry[]

  @@map("leaderboards")
}

// ============================================
// LEADERBOARD ENTRY MODEL
// ============================================

model LeaderboardEntry {
  id            String @id @default(cuid())
  leaderboardId String
  userId        Int
  score         Int
  rank          Int

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([leaderboardId, userId])
  @@map("leaderboard_entries")
}

// ============================================
// VIP TIER MODEL
// ============================================

model VipTier {
  id        String   @id @default(cuid())
  name      String
  price     Float
  perks     String // JSON stored as string for SQLite compatibility
  createdAt DateTime @default(now())

  subscriptions UserSubscription[]

  @@map("vip_tiers")
}

// Global key-value settings editable from the admin dashboard.
// Used for the CP / target-payout config (professional defaults, no client spec yet):
//   cp_per_coin              = CP earned per coin spent on a CP-eligible gift (default "1")
//   target_coins_per_dollar  = coins of received gifts equal to $1 of target payout (default "10000")
//   level_multiplier         = each level threshold = previous * this (default "1.5")
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Admin-configurable VIP levels keyed by level number (1..N).
// `threshold` is the cumulative recharge needed; if null the server computes it
// (500k per level up to 5, then +30% each level). badgeUrl + frameItemId are
// uploaded/assigned from the admin dashboard and auto-granted on level-up.
model VipLevelConfig {
  level               Int      @id
  name                String?
  threshold           Int? // cumulative coins required; null => computed
  // Direct purchase (owner request): coin price for this tier, null = not for
  // sale. durationDays null = the bought tier never expires.
  priceCoins          Int?
  durationDays        Int?
  badgeUrl            String?
  frameItemId         String? // Item.id of the seat frame granted at this level
  rewardItemIds       String[] @default([]) // Item.ids (badges/frames/entrances, app or private store) auto-granted at this level (group 10)
  // A16 — "صورة شخصية متحركة": an animated (GIF/WEBP) avatar is a VIP perk the
  // dashboard switches on per tier ("مثلاً VIP10 وما فوق"). Off everywhere by
  // default, so no existing tier silently gains the permission.
  allowAnimatedAvatar Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("vip_level_configs")
}

// Admin-configurable LV (المستوى) tiers — the XP counterpart of
// VipLevelConfig. While this table is EMPTY the built-in sqrt curve in
// xp.service is used unchanged, so adding the model moves nobody's level.
// Time a host actually spent broadcasting (on a mic seat), one row per stint.
// Agents are measured on days-and-hours, so the raw stints are stored and
// aggregated per calendar day on read rather than kept as a running total.
model BroadcastSession {
  id        String    @id @default(cuid())
  userId    Int
  roomId    Int
  startedAt DateTime  @default(now())
  endedAt   DateTime? // null = still on the mic
  seconds   Int       @default(0) // filled in when the stint closes

  @@index([userId, startedAt])
  @@index([roomId, startedAt])
  @@map("broadcast_sessions")
}

model LevelConfig {
  level         Int      @id
  name          String?
  threshold     Int? // cumulative XP required to reach this level; null => computed
  badgeUrl      String?
  rewardItemIds String[] @default([]) // Item.ids auto-granted on reaching this level
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("level_configs")
}

// ============================================
// USER SUBSCRIPTION MODEL
// ============================================

model UserSubscription {
  id       String   @id @default(cuid())
  userId   Int      @unique
  tierId   String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)
  xp       Int      @default(0)
  level    Int      @default(1)

  user User    @relation(fields: [userId], references: [id])
  tier VipTier @relation(fields: [tierId], references: [id])

  @@map("user_subscriptions")
}

// ============================================
// ITEM MODEL (CUSTOMIZATION)
// ============================================

model Item {
  id            String   @id @default(cuid())
  name          String
  description   String
  type          String // "FRAME", "PROFILE_FRAME", "ROOM_THEME", "ENTRANCE_EFFECT"
  itemType      String   @default("AVATAR")
  assetUrl      String
  priceCoins    Int      @default(0)
  isPurchasable Boolean  @default(true)
  // How long this product stays equipped once acquired. null = permanent
  // (أبدي), matching every item that existed before durations were added.
  durationDays  Int?
  // Owner request: an item granted to "جميع المستخدمين" stays flagged so every
  // account registered afterwards receives it automatically, with the same
  // duration configured in the dashboard.
  grantToAll    Boolean  @default(false)
  // Per-product layout guides set in لوحة التحكم, as fractions of the artwork:
  //   { "insets": {"l":0.18,"t":0.22,"r":0.18,"b":0.22},
  //     "slice":  {"l":0.30,"t":0.35,"r":0.30,"b":0.35} }
  // `insets` is the EMPTY inner box the app is allowed to draw content in — the
  // client's rule for chat bubbles, entry banners and mic frames alike:
  // "انا محدود داخل مربع الفقاعه الفارغ ... مليش علاقه بأي زخرفة".
  // `slice` is the 9-slice centre, so decorated end-caps never stretch when the
  // content grows. Both optional; missing = the app's built-in defaults.
  meta          Json?
  // Still poster for a VIDEO product, extracted once at upload time.
  // The store grid stopped building a player per tile (that is what made فتح
  // المتجر so slow) and needs a picture to show instead; without this every
  // مركبة rendered as a blank placeholder. null for stills — they are their own
  // poster — and for clips uploaded before posters existed.
  previewUrl    String?
  createdAt     DateTime @default(now())

  userItems  UserItem[]
  rooms      Room[]
  frameUsers User[]     @relation("UserActiveFrame")

  @@map("items")
}

// ============================================
// USER ITEM MODEL
// ============================================

model UserItem {
  id         String    @id @default(cuid())
  userId     Int
  itemId     String
  acquiredAt DateTime  @default(now())
  // Stamped from Item.durationDays at acquisition. null = never expires, so
  // every pre-existing row keeps working untouched.
  expiresAt  DateTime?
  isActive   Boolean   @default(false)
  xp         Int       @default(0)
  level      Int       @default(1)

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@map("user_items")
}

// ============================================
// FAMILY MODEL (GUILDS)
// ============================================

model Family {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  ownerId     Int      @unique
  createdAt   DateTime @default(now())

  owner   User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  members FamilyMember[]

  @@map("families")
}

// ============================================
// FAMILY MEMBER MODEL
// ============================================

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   Int      @unique
  role     String // "OWNER", "ADMIN", "MEMBER"
  joinedAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("family_members")
}

// ============================================
// ROOM VISIT MODEL (ANALYTICS)
// ============================================

model RoomVisit {
  id       String    @id @default(cuid())
  roomId   Int
  userId   Int
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  duration Int? // in seconds

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("room_visits")
}

