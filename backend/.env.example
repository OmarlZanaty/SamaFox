# Server Configuration
PORT=3000
NODE_ENV=development
MEGA_GIFT_THRESHOLD=5000

# Database Configuration
DATABASE_URL="file:./dev.db"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Secret Keys
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
# Optional extra audiences for mobile/web token verification
GOOGLE_WEB_CLIENT_ID="your-google-web-client-id"
GOOGLE_ANDROID_CLIENT_ID="your-google-android-client-id"
GOOGLE_IOS_CLIENT_ID="your-google-ios-client-id"
# Mobile app server client ID (used by GoogleSignIn(serverClientId))
GOOGLE_SERVER_CLIENT_ID="62771458278-73dh3jp1t12udcs1gp1e6atuga6ie5lg.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

SNAPCHAT_CLIENT_ID="your-snapchat-client-id"
SNAPCHAT_CLIENT_SECRET="your-snapchat-client-secret"

# Agora Configuration (for voice chat)
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="samafox-uploads"

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# CORS Configuration
# Must include the Al Mobarmg store origin, or the download button's calls to
# /api/v1/beta/* are blocked by the browser.
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# Closed-testing signup (Al Mobarmg store download button)
# Shared secret the beta-sync daemon sends as X-Sync-Key. Without it the
# /sync/* endpoints 404 and nothing is ever whitelisted. Mirror this value in
# infra/beta-sync/config.local.json on the operator's PC.
BETA_SYNC_KEY=""
# Android package the page hands off to after activation.
BETA_PACKAGE_NAME="com.almobarmg.samafox"
# Optional explicit listing URL; defaults to the Play page for the package.
BETA_PLAY_URL=""
# Optional: only needed for the Google account picker in the signup modal. The
# plain-email path works without it. Web OAuth client whose authorised
# JavaScript origins include the store domain.
GOOGLE_OAUTH_CLIENT_ID=""
# Who performs the enrolment. Keep "noop" in production: the Play Console email
# list has no API, so the beta-sync daemon does the write and the backend only
# keeps the queue. "firebase" makes App Distribution the primary channel, which
# does NOT count toward Play's 12-tester gate — it is only meant as a fallback.
BETA_ENROLL_ADAPTER="noop"
# Firebase App Distribution — the outage fallback only. When the daemon has been
# silent for 90s, testers waiting past 2 minutes get an install invite by email
# through this channel instead of staring at a spinner. Leave blank to disable
# the fallback entirely (the watchdog still alerts admins).
# Credentials come from FIREBASE_SERVICE_ACCOUNT_PATH, or the
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY pair above. The service account
# needs roles/firebaseappdistro.admin.
BETA_FAD_PROJECT_NUMBER=""
BETA_FAD_GROUP="web-testers"
FIREBASE_SERVICE_ACCOUNT_PATH=""
