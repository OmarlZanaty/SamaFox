{
  "name": "samafox-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "description": "SamaFox Social Voice Chat API Backend",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "sim:aetherfall": "ts-node --transpile-only scripts/aetherfall-sim.ts",
    "sim:neon-fortune": "ts-node --transpile-only scripts/neon-fortune-sim.ts",
    "check:neon-fortune": "ts-node --transpile-only scripts/neon-fortune-check.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:gifts": "ts-node prisma/seed-gifts.ts",
    "seed:achievements": "ts-node prisma/seed-achievements.ts",
    "fix:gift-video-format": "ts-node prisma/fix-gift-video-format.ts",
    "fix:gift-videos": "ts-node prisma/fix-existing-gift-videos.ts",
    "audit:lost-host-coins": "ts-node prisma/audit-lost-host-coins.ts",
    "drain:agency-balances": "ts-node prisma/drain-agency-balances.ts",
    "backfill:posters": "ts-node prisma/backfill-posters.ts"
  },
  "keywords": [
    "voice-chat",
    "social",
    "api",
    "websocket"
  ],
  "author": "SamaFox Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "bufferutil": "^4.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.3.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "sanitize-html": "^2.13.0",
    "ffprobe-static": "^3.1.0",
    "socket.io": "^4.8.1",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.8.1",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sanitize-html": "^2.13.0",
    "nodemon": "^3.1.10",
    "prisma": "6.17.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
